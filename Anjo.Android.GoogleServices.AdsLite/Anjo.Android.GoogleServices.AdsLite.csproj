<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net8.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.GoogleServices.AdsLite</PackageId>
		<PackageVersion>24.0.0</PackageVersion>
		<AssemblyVersion>24.0.0</AssemblyVersion>
		<FileVersion>24.0.0</FileVersion>
		<Version>24.0.0</Version>
		<Title>Anjo Android GoogleServices Ads Lite SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.GoogleServices</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) bindings for Google Play Services library 'com.google.android.gms:play-services-ads-lite'.</Description>
		<PackageReleaseNotes>GoogleServices Ads Lite SDK v24.0.0</PackageReleaseNotes>
		<Copyright>Copyright (c) 2025 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, NET MAUI, Google Play Services, Admob, Banner, Interstitial, Rewarded Interstitial</PackageTags>
		<Summary>The Google Mobile Ads SDK is the latest generation in Google mobile advertising, featuring refined ad formats and streamlined APIs for access to mobile ad networks and advertising solutions. The SDK enables mobile app developers to maximize their monetization in native mobile apps.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\play-services-ads-lite-24.0.0.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.0.3" />
		<PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="3.1.0.2" />
		<PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.5.0.1" />
		<PackageReference Include="Xamarin.GooglePlayServices.Measurement.Sdk.Api" Version="122.2.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Anjo.Android.GoogleServices.AdsBase\Anjo.Android.GoogleServices.AdsBase.csproj" />
	</ItemGroup>
</Project>